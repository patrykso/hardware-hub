# JWT signing key (required in production)
SECRET_KEY=change-me-in-production

# SQLite database file path (relative to backend working directory)
DB_PATH=hub.db

# Comma-separated allowed CORS origins for the Vue SPA
CORS_ORIGINS=http://localhost:5173

# JWT access token lifetime in hours
ACCESS_TOKEN_EXPIRE_HOURS=8

# Default admin user created on first startup when no admin exists
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

